# Copy to .env.local and fill in values from your Firebase project
# (Project Settings → General → Your apps → Web app config)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side (Firebase Admin SDK) — download service account JSON from
# Project Settings → Service accounts → Generate new private key.
# Paste the full JSON string on one line (or base64-encode it).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Gemini / Google AI key for Genkit (AI Studio → Get API key)
GOOGLE_GENAI_API_KEY=

# Shared secret for Apple Shortcuts → /api/health-sync webhook
HEALTH_SYNC_SECRET=change-me-to-a-long-random-string
