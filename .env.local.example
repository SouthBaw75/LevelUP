# Copy to .env.local and fill in values from your Firebase project
# (Project Settings → General → Your apps → Web app config)

# REQUIRED — Firebase web client config (needed for sign-in + Firestore + AI)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# Everything below is OPTIONAL — the app runs (sign-in, Rex chat,
# rocket, history) without these. Fill in only when you're ready
# to wire up the Apple Health → Firestore webhook.
# ─────────────────────────────────────────────────────────────

# Admin SDK — only used by /api/health-sync. Paste the service-account JSON
# (one line, or base64-encoded). Generate from Project Settings → Service
# accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared secret for Apple Shortcuts → /api/health-sync webhook.
# Generate with: openssl rand -hex 32
HEALTH_SYNC_SECRET=
